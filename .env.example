# Copy to .env and fill in. Never commit .env.
ZIP=
VAPID_PRIVATE_KEY=
# Fine-grained GitHub token: repo Himalpok1/duo-tracker only, permission Contents = Read and write.
GITHUB_TOKEN=
GITHUB_REPOSITORY=Himalpok1/duo-tracker
RADIUS_MILES=30
INTERVAL_SEC=30
INCLUDE_CARRIER=false
# 0 = run forever
RUN_MINUTES=0
